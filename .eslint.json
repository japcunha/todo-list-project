{
  "env": {
    "commonjs": true,
    "es2021": true,
    "node": true
  },
  "extends": "eslint:recomended",
  "parserOptions": {
    "ecmaVersion": "latest"
  },
  "rules": {
    "indent": ["error", 2],
    "linebreak-style": ["error", "unix"],
    "quotes": ["error", "single"],
    "quotes": ["error", "single"],
    "semi": ["error", "single"],
    "semi": ["error", "single"],
    "semi": ["error", "always"]
  }
}
